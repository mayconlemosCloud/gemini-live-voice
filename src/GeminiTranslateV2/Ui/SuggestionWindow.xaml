<ui:FluentWindow x:Class="GeminiTranslate.App.Ui.SuggestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Sugestão de resposta" Width="480" Height="380"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Acrylic" WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Sugestão de resposta">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="SparkleCircle24"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="16,4,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:TextBlock Grid.Row="0" Text="Pergunta" FontTypography="Caption"
                          Margin="2,0,0,4"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ui:TextBlock x:Name="QuestionText" Grid.Row="1" TextWrapping="Wrap"
                          FontTypography="BodyStrong" Margin="2,0,0,14"/>

            <Border Grid.Row="2" CornerRadius="8"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                <TextBox x:Name="AnswerBox" IsReadOnly="True" TextWrapping="Wrap" FontSize="14"
                         VerticalScrollBarVisibility="Auto"
                         Background="Transparent" BorderThickness="0" Padding="14,12"/>
            </Border>

            <DockPanel Grid.Row="3" Margin="0,12,0,0">
                <ui:Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copiar"
                           Icon="{ui:SymbolIcon CopySelect24}" Appearance="Primary"
                           MinWidth="104" Height="34" Click="OnCopy"/>
                <ui:TextBlock Text="Esc fecha" FontTypography="Caption" VerticalAlignment="Center"
                              Margin="2,0,0,0"
                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
