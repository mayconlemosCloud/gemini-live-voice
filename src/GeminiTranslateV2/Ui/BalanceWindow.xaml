<Window x:Class="GeminiTranslate.App.Ui.BalanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tradução" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontSize="11" Foreground="#EAEAEA">
    <Border CornerRadius="9" Background="#E61E1F22" Padding="11,8" Margin="6"
            BorderBrush="#3A3D42" BorderThickness="1"
            MouseLeftButtonDown="OnDrag" Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel x:Name="OutRow"
                        ToolTip="Sua fala numa janela de 8 s. A parte cheia já saiu traduzida; a parte escura à direita é o que você disse e ainda não saiu. O traço é a cabeça da tradução, a borda direita é você agora.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="você" Width="32" Foreground="#9AA0A6" VerticalAlignment="Center"/>
                    <Grid Width="170" Height="9" VerticalAlignment="Center">
                        <Border CornerRadius="4" Background="#2B2E33"/>
                        <Border x:Name="OutFill" HorizontalAlignment="Left" Width="0" CornerRadius="4"/>
                        <Border x:Name="OutHead" HorizontalAlignment="Left" Width="2" Background="#FFFFFF"/>
                    </Grid>
                </StackPanel>
                <TextBlock x:Name="OutText" Margin="32,3,0,0" Text="sem fala pendente"/>
            </StackPanel>

            <StackPanel x:Name="InRow" Margin="0,9,0,0"
                        ToolTip="A fala da outra pessoa, na mesma escala. A parte cheia já saiu traduzida no seu fone; a escura ainda está por sair.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="eles" Width="32" Foreground="#9AA0A6" VerticalAlignment="Center"/>
                    <Grid Width="170" Height="9" VerticalAlignment="Center">
                        <Border CornerRadius="4" Background="#2B2E33"/>
                        <Border x:Name="InFill" HorizontalAlignment="Left" Width="0" CornerRadius="4"/>
                        <Border x:Name="InHead" HorizontalAlignment="Left" Width="2" Background="#FFFFFF"/>
                    </Grid>
                </StackPanel>
                <TextBlock x:Name="InText" Margin="32,3,0,0" Text="sem fala pendente"/>
            </StackPanel>

            <DockPanel Margin="32,5,0,0" Width="170" HorizontalAlignment="Left">
                <TextBlock Text="−8 s" Foreground="#6B6E73" FontSize="10"/>
                <TextBlock Text="agora ▲" Foreground="#6B6E73" FontSize="10"
                           DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
