<Window x:Class="GeminiTranslate.App.Ui.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copiloto" Width="580" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontSize="13" Foreground="#EAEAEA">
    <Border CornerRadius="10" Background="#F21E1F22" Padding="8" Margin="6"
            BorderBrush="#3A3D42" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel>
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TitleText" Text="🤖 Copiloto" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="4,0,10,0" Cursor="SizeAll"
                           MouseLeftButtonDown="OnDragBar"/>
                <TextBlock x:Name="StatusText" Text="pronto" Foreground="#9AA0A6"
                           VerticalAlignment="Center"/>

                <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="✕" Width="28" Height="28"
                        Margin="4,0,0,0" Click="OnClose" ToolTip="Fechar overlay"/>
                <Button x:Name="ToggleButton" DockPanel.Dock="Right" Content="▾" Width="28" Height="28"
                        Margin="4,0,0,0" Click="OnTogglePanel" ToolTip="Mostrar/ocultar resultado"/>
                <Button x:Name="SuggestButton" DockPanel.Dock="Right" Content="🧠 Sugerir" Height="28"
                        Margin="4,0,0,0" Padding="8,0" Click="OnSuggest"
                        ToolTip="Sugerir resposta com base na conversa toda (Ctrl+Shift+3)"/>
                <Button x:Name="RegionButton" DockPanel.Dock="Right" Content="✂️ Região" Height="28"
                        Margin="4,0,0,0" Padding="8,0" Click="OnRegion"
                        ToolTip="Selecionar uma região da tela para a IA analisar (Ctrl+Shift+2)"/>
                <Button x:Name="ScreenButton" DockPanel.Dock="Right" Content="📷 Tela" Height="28"
                        Margin="4,0,0,0" Padding="8,0" Click="OnScreen"
                        ToolTip="Tirar print da tela toda para a IA analisar (Ctrl+Shift+1)"/>
            </DockPanel>

            <Border x:Name="ResultPanel" Visibility="Visible" Margin="0,8,0,0"
                    Background="#26282C" CornerRadius="6">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="ResultBox" Grid.Row="0" IsReadOnly="True" TextWrapping="Wrap"
                             MinHeight="60" MaxHeight="260" VerticalScrollBarVisibility="Auto"
                             Background="Transparent" Foreground="#EAEAEA" BorderThickness="0"/>
                    <DockPanel Grid.Row="1" Margin="0,6,0,0">
                        <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copiar" Width="80"
                                Height="26" Click="OnCopy" ToolTip="Copiar todo o chat"/>
                        <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="🧹 Limpar" Width="80"
                                Height="26" Margin="0,0,6,0" Click="OnClearChat"
                                ToolTip="Apagar o chat do assistente (não apaga a transcrição da reunião)"/>
                    </DockPanel>

                    <DockPanel Grid.Row="2" Margin="0,6,0,0">
                        <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Enviar" Width="70"
                                Height="28" Margin="6,0,0,0" Click="OnSend"
                                ToolTip="Enviar a pergunta para o assistente (Enter)"/>
                        <TextBox x:Name="InputBox" Height="28" VerticalContentAlignment="Center"
                                 Background="#1E1F22" Foreground="#EAEAEA" CaretBrush="#EAEAEA"
                                 BorderBrush="#3A3D42" BorderThickness="1" Padding="6,0"
                                 KeyDown="OnInputKeyDown"
                                 ToolTip="Pergunte qualquer coisa ao assistente · Enter envia"/>
                    </DockPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
