<Window x:Class="GeminiTranslate.App.Ui.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Assistente" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Border CornerRadius="10" Background="#E61E2028" Padding="8" Margin="6"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.55"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="SparkleCircle24" Margin="4,0,8,0" VerticalAlignment="Center"
                           Cursor="SizeAll" MouseLeftButtonDown="OnDragBar"/>

            <ui:Button x:Name="ScreenButton" Content="Tela" Icon="{ui:SymbolIcon Screenshot24}"
                       Height="30" Click="OnScreen"
                       ToolTip="Analisar um print da tela toda (Ctrl+Shift+1)"/>
            <ui:Button x:Name="RegionButton" Content="Região" Icon="{ui:SymbolIcon Crop24}"
                       Height="30" Margin="6,0,0,0" Click="OnRegion"
                       ToolTip="Analisar uma região da tela (Ctrl+Shift+2)"/>
            <ui:Button x:Name="SuggestButton" Content="Sugerir" Icon="{ui:SymbolIcon LightbulbFilament24}"
                       Height="30" Margin="6,0,0,0" Click="OnSuggest"
                       ToolTip="Sugerir uma resposta agora (Ctrl+Shift+3)"/>

            <ui:TextBlock x:Name="StatusText" Text="pronto" VerticalAlignment="Center"
                          Margin="12,0,4,0" MaxWidth="220" TextTrimming="CharacterEllipsis"
                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

            <ui:Button x:Name="CloseButton" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                       Width="32" Height="30" Margin="8,0,0,0" Click="OnClose"
                       ToolTip="Fechar esta barra. O assistente continua na aba da janela principal."/>
        </StackPanel>
    </Border>
</Window>
